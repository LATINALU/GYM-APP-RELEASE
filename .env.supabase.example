# Migración Firebase->Supabase, módulo por módulo — ver plan en
# C:\Users\Brain\.claude\plans\magical-honking-hellman.md
# Copiar a .env.supabase (gitignored) y completar con valores reales del VPS.
# SUPABASE_URL y SUPABASE_ANON_KEY no son secretos (el anon key está diseñado
# para vivir en el cliente; la seguridad real la da RLS en Postgres).
# SUPABASE_JWT_BRIDGE_URL apunta a la función server-side de intercambio de
# token (Supabase Edge Function, ver supabase/functions/firebase-token-exchange).
# El secreto de firma (SUPABASE_JWT_SECRET / FIREBASE_PROJECT_ID) vive SOLO
# en el entorno de esa función — nunca en este archivo ni en el cliente.

SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=changeme
SUPABASE_JWT_BRIDGE_URL=http://localhost:8000/functions/v1/firebase-token-exchange
USE_SUPABASE_MEASUREMENTS=false
USE_SUPABASE_RECOVERY=false
USE_SUPABASE_VOLUME=false
USE_SUPABASE_NUTRITION=false
USE_SUPABASE_ACCESS_CODES=false
USE_SUPABASE_PENDING_REGISTRATIONS=false
# Un solo flag para gyms + gym_members: gym_members tiene una FK a gyms,
# así que conviene migrarlos juntos en vez de arriesgar que queden
# desincronizados (uno en Supabase, el otro todavía en Firebase).
USE_SUPABASE_IDENTITY=false
