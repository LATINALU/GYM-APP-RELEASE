# ═══════════════════════════════════════════════════════════════
# GYM-APP Local Development Environment
# For Docker Desktop testing on Windows
# ═══════════════════════════════════════════════════════════════

# Server
PORT=7130

# PostgreSQL
POSTGRES_USER=gymapp
POSTGRES_PASSWORD=gymapp_secret
POSTGRES_DB=gymapp

# URLs (localhost)
API_BASE_URL=http://localhost:7130
VITE_API_BASE_URL=http://localhost:7130

# Authentication (simple for local dev)
JWT_SECRET=local_development_jwt_secret_32_chars_min
ADMIN_EMAIL=superadmin@gym-app.com
ADMIN_PASSWORD=super123

# Encryption (simple for local dev)
ENCRYPTION_KEY=local_development_encryption_key_32

# API Key (must start with ik_)
ACCESS_API_KEY=ik_local_development_api_key_32

# Storage (local filesystem - no S3 needed for local dev)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=

# Logs directory
LOGS_DIR=/insforge-logs

# Storage directory
STORAGE_DIR=/insforge-storage
